<mujoco>
  <compiler autolimits="true"/>
  <default>
    <site type="sphere" rgba="1 0 0 1" size="0.005"/>
    <tendon rgba="0.4 0.4 0.4 0.35" width="0.001"/>
    <default class="gripper_surface">
      <geom contype="0" conaffinity="0" group="1" material="gripper_surface_material"
            rgba="0.94 0.94 0.94 1"/>
    </default>
    <default class="gripper_edge">
      <geom contype="0" conaffinity="0" group="1" rgba="0.10 0.12 0.14 1"/>
    </default>
    <default class="finger_pad_collision">
      <geom contype="2" conaffinity="1" group="3" condim="4"
            friction="3.0 0.08 0.003" solref="0.005 1"
            solimp="0.95 0.99 0.001" margin="0.001"
            rgba="0.94 0.94 0.94 1"/>
    </default>
  </default>
  <visual>
    <headlight diffuse=".7 .7 .7"/>
  </visual>

  <asset>
    <material name="gripper_surface_material" rgba="1 1 1 1"
              specular="0.35" shininess="0.45" reflectance="0.08"/>
    <!-- Real CAD base, converted from the supplied ASCII STL to binary STL for MuJoCo. -->
    <mesh name="real_gripper_base" file="meshes/base2.stl"
          scale="0.00055 0.00055 0.00055"/>
  </asset>

  <worldbody>
    <light name="side_light"
         pos="1.0 -1.0 2.0"
         dir="-1 1 -1"
         diffuse="0.6 0.6 0.6"
         specular="0.1 0.1 0.1"
         directional="true"
         castshadow="false"/>
    <!--
      The CPU environment historically used a programmatic free camera for
      this view.  A named, fixed camera is required by the batched MJWarp
      renderer and also makes the policy camera contract explicit.
    -->
    <camera name="overview" mode="fixed" pos="0 -1.299 0.85"
            xyaxes="1 0 0 0 0.5 0.8660254" fovy="45"/>

    <body name="rotor_1_up" pos="-0.535 -0.755 1.309" euler="90 45 0">
      <geom name="rotor_1_up" type="cylinder" size=".025 .05"/>
      <site name="top_main_site_1" pos="-0.025 0.00001 0" />
      <site name="top_sidesite_1" pos="0 0.05 0" />
      
      <body name="rotor_1_down" pos="0 -1.309 0" euler="0 0 0">
        <geom name="rotor_1_down" type="cylinder" size=".025 .05"/>
        <site name="bot_main_site_1" pos="0.025 -0.00001 0" />
        <site name="bot_sidesite_1" pos="0 -0.05 0" />

        <body name="slider_1" pos="-2 0 0">
          <inertial pos="0 0 0" mass="2" diaginertia="0.0001 0.0001 0.0001" />
          <joint name="slider_1" type="slide" axis="-1 0 0" damping="5"/>
          <geom type="box" size="0.01 0.01 0.01" />
          <site name="slider_1" pos="0.01 0 0"/>
        </body>
      </body>
    </body>

    <body name="rotor_2_up" pos="0.755 -0.525 1.309" euler="90 135 0">
      <geom name="rotor_2_up" type="cylinder" size=".025 .05"/>
      <site name="top_main_site_2" pos="-0.025 0.00001 0" />
      <site name="top_sidesite_2" pos="0 0.05 0" />

      <body name="rotor_2_down" pos="0 -1.309 0" euler="0 0 0">
        <geom name="rotor_2_down" type="cylinder" size=".025 .05"/>
        <site name="bot_main_site_2" pos="0.025 -0.00001 0" />
        <site name="bot_sidesite_2" pos="0 -0.05 0" />

        <body name="slider_2" pos="-2 0 0">
          <inertial pos="0 0 0" mass="2" diaginertia="0.0001 0.0001 0.0001" />
          <joint name="slider_2" type="slide" axis="-1 0 0" damping="5"/>
          <geom type="box" size="0.01 0.01 0.01" />
          <site name="slider_2" pos="0.01 0 0"/>
        </body>
      </body>
    </body>

    <body name="rotor_3_up" pos="0.535 0.755 1.309" euler="90 -135 0">
      <geom name="rotor_3_up" type="cylinder" size=".025 .05"/>
      <site name="top_main_site_3" pos="-0.025 0.00001 0" />
      <site name="top_sidesite_3" pos="0 0.05 0" />

      <body name="rotor_3_down" pos="0 -1.309 0" euler="0 0 0">
        <geom name="rotor_3_down" type="cylinder" size=".025 .05"/>
        <site name="bot_main_site_3" pos="0.025 -0.00001 0" />
        <site name="bot_sidesite_3" pos="0 -0.05 0" />

        <body name="slider_3" pos="-2 0 0">
          <inertial pos="0 0 0" mass="2" diaginertia="0.0001 0.0001 0.0001" />
          <joint name="slider_3" type="slide" axis="-1 0 0" damping="5"/>
          <geom type="box" size="0.01 0.01 0.01" />
          <site name="slider_3" pos="0.01 0 0"/>
        </body>
      </body>
    </body>

    <body name="rotor_4_up" pos="-0.755 0.525 1.309" euler="90  -45 0">
      <geom name="rotor_4_up" type="cylinder" size=".025 .05"/>
      <site name="top_main_site_4" pos="-0.025 0.00001 0" />
      <site name="top_sidesite_4" pos="0 0.05 0" />

      <body name="rotor_4_down" pos="0 -1.309 0" euler="0 0 0">
        <geom name="rotor_4_down" type="cylinder" size=".025 .05"/>
        <site name="bot_main_site_4" pos="0.025 -0.00001 0" />
        <site name="bot_sidesite_4" pos="0 -0.05 0" />

        <body name="slider_4" pos="-2 0 0">
          <inertial pos="0 0 0" mass="2" diaginertia="0.0001 0.0001 0.0001" />
          <joint name="slider_4" type="slide" axis="-1 0 0" damping="5"/>
          <geom type="box" size="0.01 0.01 0.01" />
          <site name="slider_4" pos="0.01 0 0"/>
        </body>
      </body>
    </body>

    <!-- Floor -->
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 -0.1" rgba="0.8 0.8 0.8 1"/>
    
    <!-- Red square object on floor -->
    <!--<body name="target_object" pos="0.5 0.5 0">
      <geom type="box" size="0.1 0.1 0.01" rgba="1 0 0 1"/>
    </body> -->

    <!-- End-effector -->
    <!-- ===== Cable-suspended base (translation+rotation from cables) ===== -->
    <body name="ee_base" pos="0 0 0.40">
      <joint name="ee_free" type="free" damping="3" armature="0.002"/>
      <inertial pos="0 0 0" mass="1.2" diaginertia="0.02 0.02 0.02"/>

      <!-- Cable attachment point from the reference image; coordinates are unchanged. -->
      <site name="topcenter" pos="0 0 0.08" size="0.008" rgba="1 0 0 1"/>

      <!-- ===== NEW: intermediate yaw body ===== -->
      <body name="yaw_frame" pos="0 0 0">
        <!-- must have inertial because it has a joint -->
        <inertial pos="0 0 0" mass="0.15" diaginertia="0.0006 0.0006 0.0006"/>
        <joint name="ee_yaw" type="hinge" axis="0 0 1"
              limited="true" range="-180 180" damping="0.4"/>

        <!-- ===== Orientation stabilizer under yaw ===== -->
        <body name="ee_stab" pos="0 0 0">
          <inertial pos="0 0 0" mass="0.6" diaginertia="0.005 0.005 0.005"/>
          <joint name="ee_ball" type="ball" damping="6" stiffness="80" armature="0.02" limited="false"/>

          <!-- Camera follows the lowered mesh while retaining its clear downward view. -->
          <body name="camera_body" pos="0 0.05 0.045">
            <site name="ee_camera_marker" type="sphere" size="0.005" rgba="0 1 0 1"/>
            <camera name="ee_camera" mode="fixed" fovy="60" euler="-15 0 0"/>
          </body>

          <!-- Gripper -->
          <body name="ee_platform" pos="0 0 0.08">
            <inertial pos="0 0 0" mass="0.35" diaginertia="0.003 0.003 0.003"/>

            <!-- The supplied base is lowered so topcenter lies on top of the circular
                 housing; its camera mount still points toward camera_body at +Y. -->
            <geom name="palm" class="gripper_surface" type="mesh" mesh="real_gripper_base"
                  pos="0 0 -0.025" euler="180 0 0"/>

            <!-- The synchronized slide-joint control contract is unchanged. -->
            <body name="finger_left_car" pos="0.02 0 0">
              <inertial pos="0 0 0" mass="0.08" diaginertia="0.0002 0.0002 0.00015"/>
              <joint name="finger_l" type="slide" axis="1 0 0" limited="true" range="0 0.03" damping="3.0"/>
              <geom name="finger_l_shoulder" class="gripper_surface" type="capsule"
                    fromto="0.010 0 -0.055  0 0 -0.070" size="0.0025"/>
              <geom name="finger_l_shoulder_edge_front" class="gripper_edge" type="capsule"
                    fromto="0.014 -0.0065 -0.0565  0.004 -0.0065 -0.0715" size="0.0013"/>
              <geom name="finger_l_shoulder_edge_back" class="gripper_edge" type="capsule"
                    fromto="0.014 0.0065 -0.0565  0.004 0.0065 -0.0715" size="0.0013"/>
              <geom name="finger_l_link" class="gripper_surface" type="box"
                    size="0.0025 0.012 0.0175" pos="0 0 -0.0875"/>
              <geom name="finger_l_tip" class="gripper_surface" type="box"
                    size="0.0025 0.012 0.007" pos="0 0 -0.112"/>
              <geom name="finger_l_edge_front_outer" class="gripper_edge" type="capsule"
                    fromto="0.0018 -0.0125 -0.0695  0.0018 -0.0125 -0.1195" size="0.0007"/>
              <geom name="finger_l_edge_front_inner" class="gripper_edge" type="capsule"
                    fromto="-0.0018 -0.0125 -0.0695  -0.0018 -0.0125 -0.1195" size="0.0007"/>
              <geom name="finger_l_edge_back_outer" class="gripper_edge" type="capsule"
                    fromto="0.0018 0.0125 -0.0695  0.0018 0.0125 -0.1195" size="0.0007"/>
              <geom name="finger_l_edge_back_inner" class="gripper_edge" type="capsule"
                    fromto="-0.0018 0.0125 -0.0695  -0.0018 0.0125 -0.1195" size="0.0007"/>
              <geom name="finger_l_edge_front_bottom" class="gripper_edge" type="capsule"
                    fromto="-0.0018 -0.0125 -0.1195  0.0018 -0.0125 -0.1195" size="0.0007"/>
              <geom name="finger_l_edge_back_bottom" class="gripper_edge" type="capsule"
                    fromto="-0.0018 0.0125 -0.1195  0.0018 0.0125 -0.1195" size="0.0007"/>
              <geom name="left_finger_pad" class="finger_pad_collision" type="box"
                    size="0.0025 0.014 0.0175" pos="0 0 -0.0875"/>
            </body>

            <body name="finger_right_car" pos="-0.02 0 0">
              <inertial pos="0 0 0" mass="0.08" diaginertia="0.0002 0.0002 0.00015"/>
              <joint name="finger_r" type="slide" axis="-1 0 0" limited="true" range="0 0.03" damping="3.0"/>
              <geom name="finger_r_shoulder" class="gripper_surface" type="capsule"
                    fromto="-0.010 0 -0.055  0 0 -0.070" size="0.0025"/>
              <geom name="finger_r_shoulder_edge_front" class="gripper_edge" type="capsule"
                    fromto="-0.014 -0.0065 -0.0565  -0.004 -0.0065 -0.0715" size="0.0013"/>
              <geom name="finger_r_shoulder_edge_back" class="gripper_edge" type="capsule"
                    fromto="-0.014 0.0065 -0.0565  -0.004 0.0065 -0.0715" size="0.0013"/>
              <geom name="finger_r_link" class="gripper_surface" type="box"
                    size="0.0025 0.012 0.0175" pos="0 0 -0.0875"/>
              <geom name="finger_r_tip" class="gripper_surface" type="box"
                    size="0.0025 0.012 0.007" pos="0 0 -0.112"/>
              <geom name="finger_r_edge_front_outer" class="gripper_edge" type="capsule"
                    fromto="-0.0018 -0.0125 -0.0695  -0.0018 -0.0125 -0.1195" size="0.0007"/>
              <geom name="finger_r_edge_front_inner" class="gripper_edge" type="capsule"
                    fromto="0.0018 -0.0125 -0.0695  0.0018 -0.0125 -0.1195" size="0.0007"/>
              <geom name="finger_r_edge_back_outer" class="gripper_edge" type="capsule"
                    fromto="-0.0018 0.0125 -0.0695  -0.0018 0.0125 -0.1195" size="0.0007"/>
              <geom name="finger_r_edge_back_inner" class="gripper_edge" type="capsule"
                    fromto="0.0018 0.0125 -0.0695  0.0018 0.0125 -0.1195" size="0.0007"/>
              <geom name="finger_r_edge_front_bottom" class="gripper_edge" type="capsule"
                    fromto="-0.0018 -0.0125 -0.1195  0.0018 -0.0125 -0.1195" size="0.0007"/>
              <geom name="finger_r_edge_back_bottom" class="gripper_edge" type="capsule"
                    fromto="-0.0018 0.0125 -0.1195  0.0018 0.0125 -0.1195" size="0.0007"/>
              <geom name="right_finger_pad" class="finger_pad_collision" type="box"
                    size="0.0025 0.014 0.0175" pos="0 0 -0.0875"/>
            </body>
          </body>
        </body>
      </body>
    </body>

  
  </worldbody>

  <equality>
    <!-- Enforce q_r = q_l  (10 poly coefficients: a0..a9). q2 = a0 + a1*q1 + ... -->
    <joint joint1="finger_l" joint2="finger_r" polycoef="0 1 0 0 0"/>
  </equality>

  <tendon>
    <spatial name="rope_1" limited="true" range="0 4.235" stiffness="0" damping="0" >
      <site site="topcenter" />
      <geom geom="rotor_1_up" sidesite="top_sidesite_1" />
      <site site="top_main_site_1" />
      <site site="bot_main_site_1" />
      <geom geom="rotor_1_down" sidesite="bot_sidesite_1" />
      <site site="slider_1" />
    </spatial>

    <spatial name="rope_2" limited="true" range="0 4.235" stiffness="0" damping="0" >
      <site site="topcenter" />
      <geom geom="rotor_2_up" sidesite="top_sidesite_2" />
      <site site="top_main_site_2" />
      <site site="bot_main_site_2" />
      <geom geom="rotor_2_down" sidesite="bot_sidesite_2" />
      <site site="slider_2" />
    </spatial>

    <spatial name="rope_3" limited="true" range="0 4.235" stiffness="0" damping="0" >
      <site site="topcenter" />
      <geom geom="rotor_3_up" sidesite="top_sidesite_3" />
      <site site="top_main_site_3" />
      <site site="bot_main_site_3" />
      <geom geom="rotor_3_down" sidesite="bot_sidesite_3" />
      <site site="slider_3" />
    </spatial>

    <spatial name="rope_4" limited="true" range="0 4.235" stiffness="0" damping="0" >
      <site site="topcenter" />
      <geom geom="rotor_4_up" sidesite="top_sidesite_4" />
      <site site="top_main_site_4" />
      <site site="bot_main_site_4" />
      <geom geom="rotor_4_down" sidesite="bot_sidesite_4" />
      <site site="slider_4" />
    </spatial>
  </tendon>

  <actuator>
    <position name="slider_1_pos" joint="slider_1" ctrlrange="-4.5 4.5" kp="2400" kv="300"/>
    <position name="slider_2_pos" joint="slider_2" ctrlrange="-4.5 4.5" kp="2400" kv="300"/>
    <position name="slider_3_pos" joint="slider_3" ctrlrange="-4.5 4.5" kp="2400" kv="300"/>
    <position name="slider_4_pos" joint="slider_4" ctrlrange="-4.5 4.5" kp="2400" kv="300"/>
    <!-- Tool yaw and gripper -->
    <position name="act_ee_yaw" joint="ee_yaw" kp="30" ctrlrange="-180 180"/>
    <!-- Normalized gripper target: ctrl=0 is closed, ctrl=1 maps to 0.03 m finger travel. -->
    <position name="act_gripper" joint="finger_l" kp="2.0" gear="33.3333333333" ctrlrange="0 1"/>
  </actuator>


  <sensor>
    <framepos objtype="camera" objname="overview"/>
    <framequat objtype="camera" objname="overview"/>
    <framepos objtype="camera" objname="ee_camera"/>
    <framequat objtype="camera" objname="ee_camera"/>
  </sensor>
</mujoco>
