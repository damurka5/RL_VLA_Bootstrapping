<mujoco model="cdpr_mjwarp_object_slots">
  <!--
    Fixed hybrid topology for the MJWarp backend. Every free-body slot has one
    curated RoboCasa visual mesh and the same eleven native primitive collider
    slots. Per-world size/pose fields activate the CDPR collider set; unused
    primitives remain tiny and far above their owning body. Initial slot poses
    are above the floor and outside the workspace because MuJoCo planes are
    infinite and a body parked below one would be deeply penetrating it.
  -->
