<mujoco model="cdpr_mjwarp_object_slots">
  <!--
    Fixed topology for the MJWarp backend.  Every slot has the same primitive
    superset.  Per-world model arrays choose catalog geometry, material, mass,
    and inertia without recompiling MJCF.  The initial pose is intentionally
    below the floor; reset activates only configured slots.
  -->
  <default>
    <default class="mjwarp_object_slot">
      <geom contype="1" conaffinity="7" group="3" condim="3"
            friction="0.9 0.01 0.001" solref="0.008 1"
            solimp="0.90 0.95 0.001" margin="0.001"/>
    </default>
  </default>
  <worldbody>
    <body name="mjwarp_object_slot_0" pos="0 0 -4" childclass="mjwarp_object_slot">
      <freejoint name="mjwarp_object_slot_0_free"/>
